#INCLUDE "01_standard_terms.lc"
#INCLUDE "02_fol.lc"
INCLUDE "03_pair.lc"

0,  zero                := ⊥
successor               := λn f x  .f (n f x)
1,  one                 := successor 0
2,  two                 := successor 1
3,  three               := successor 2
4,  four                := successor 3
5,  five                := successor 4
6,  six                 := successor 5
7,  seven               := successor 6
8,  eight               := successor 7
9,  nine                := successor 8
10, ten                 := successor 9
11, eleven              := successor 10
12, twelve              := successor 11
13, thirteen            := successor 12
14, fourteen            := successor 13
15, fifteen             := successor 14
16, sixteen             := successor 15
17, seventeen           := successor 16
18, eighteen            := successor 17
19, nineteen            := successor 18
20, twenty              := successor 19
21, twenty-one          := successor 20
22, twenty-two          := successor 21
23, twenty-three        := successor 22
24, twenty-four         := successor 23
25, twenty-five         := successor 24
26, twenty-six          := successor 25
27, twenty-seven        := successor 26
28, twenty-eight        := successor 27
29, twenty-nine         := successor 28
30, thirty              := successor 29
31, thirty-one          := successor 30
32, thirty-two          := successor 31
# TODO need a way to meta-programmatically define more numbers

#+                       := λm n f x.m f (n f x)
#+,  plus, add            ≡ λm n    .m successor n

#*                        ≡ B
#*                       := B
#ASSERT_EQ *, λm n f.m (n f)
#*, times, multiply       ≡ λm n    .m (+ n) 0
#**                      := λb n f  .n b f
#**, power, exponentiate  ≡ λb n    .n b
#**                       ≡ λbn     .n (* b) 1
#**, power, expoentiate   ≡ λb n.   if (=0 n) 1 (n b) # FIXME

+, plus, add             := λm n f x.m f (n f x)
*, times, multiply       := B
**, power, exponentiate  := λb n    .n b

predecessor             := λn      .1st (n (Ψ successor) (pair 0 0))
predecessor              ≡ λn f x  .n (λg h.h (g f)) (λu.x) I

-, minus, subtract      := λm n    .n predecessor m

=0, eqz                 := λn      .n (λx.⊥) ⊤
≤,  leq                 := λm n    .=0 (- m n)
≥,  geq                 := λm n    .≤ n m
>,  gt                  := λm n    .¬ (≤ m n)
<,  lt                  := λm n    .> n m
EQ_NUM                  := λm n    .∧ (=0 (- m n)) (=0 (- n m))

# TODO
# ≠

# Division & Modulo
# / (division)
# ÷
DIV_REC     := λself m n. if (≤ n m) (successor (self (- m n) n)) 0
div         := Y DIV_REC

MOD_REC     := λself m n. if (≤ n m) (self (- m n) n) m
mod         := Y MOD_REC


