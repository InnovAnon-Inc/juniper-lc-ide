Y := \a.(\b.a (b b)) (\b.a (b b))
Y2 := Y
Z := \a.(\b.a (\c.b b c)) (\b.a (\c.b b c))
⊤, TRUE := K
⊥, FALSE := \a b.b
¬, NOT := \a.a ⊥ K
∧, AND := \a b.a b ⊥
∨, OR := \a b.a K b
IF := \a b c.a b c
ASSERT K
ASSERT ¬ ⊥
ASSERT ∧ K K
ASSERT ¬ (∧ K ⊥)
ASSERT ¬ (∧ ⊥ K)
