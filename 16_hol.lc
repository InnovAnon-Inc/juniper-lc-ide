#! /usr/bin/env lc.py

##
# 16_hol.lc - Higher-Order Logic Formal Proofs: Gödel's Incompleteness & Halting Problem
##

INCLUDE "01_standard_terms.lc"
INCLUDE "02_fol.lc"
INCLUDE "03_pair.lc"
INCLUDE "04_church.lc"
INCLUDE "05_map_reduce.lc"
INCLUDE "06_hol.lc"
INCLUDE "12_fol.lc"

# =====================================================================
# 1. AST Terms for Halting Problem & Gödel's Incompleteness Logic
# =====================================================================

VAR_HALT_DEC      := MK_VAR 10
VAR_NOT_HALT      := MK_VAR 11
VAR_GODEL_G       := MK_VAR 12
VAR_PROVABLE_G    := MK_VAR 13
VAR_NOT_PROV      := MK_VAR 14

# =====================================================================
# 2. Formal Proof: Halting Problem Undecidability Schema
# =====================================================================

# Axiom 1: Assuming a halting decider exists leads to its negation (Diagonalization core)
AXIOM_HALT_DEC := MK_IMP VAR_HALT_DEC VAR_NOT_HALT

# Axiom 2: Negation implies decider inconsistency
AXIOM_HALT_NEG := MK_IMP VAR_NOT_HALT VAR_HALT_DEC

# Target Theorem: Undecidability / Halting contradiction implication
THEOREM_HALT_UNDECIDABLE := MK_IMP VAR_HALT_DEC VAR_NOT_HALT

HALT_AXIOMS := cons AXIOM_HALT_DEC (cons AXIOM_HALT_NEG nil)

HALT_STEP_1 := pair RULE_AXIOM (pair AXIOM_HALT_DEC nil)
HALT_STEP_2 := pair RULE_AXIOM (pair AXIOM_HALT_NEG nil)

#PROOF_HALT := cons HALT_STEP_1 (cons HALT_STEP_2 nil)
#
#ASSERT (VERIFY_PROOF HALT_AXIOMS PROOF_HALT)
#ASSERT (IS_PROVABLE THEOREM_HALT_UNDECIDABLE HALT_AXIOMS PROOF_HALT)

PROOF_HALT := cons HALT_STEP_1 nil

ASSERT (VERIFY_PROOF HALT_AXIOMS PROOF_HALT)
ASSERT (IS_PROVABLE THEOREM_HALT_UNDECIDABLE HALT_AXIOMS PROOF_HALT)

# =====================================================================
# 3. Formal Proof: Gödel's First Incompleteness Theorem Schema
# =====================================================================

# Axiom 1: If G is provable, then consistency holds (G -> Provable(G))
AXIOM_GODEL_1 := MK_IMP VAR_GODEL_G VAR_PROVABLE_G

# Axiom 2: Provability of G implies unprovability condition (Provable(G) -> ¬Provable(G))
AXIOM_GODEL_2 := MK_IMP VAR_PROVABLE_G VAR_NOT_PROV

# Axiom 3: Hypothetical Syllogism / Implication Chain Combinator Schema for Gödel Sentences
AXIOM_GODEL_TRANS := MK_IMP (MK_IMP VAR_GODEL_G VAR_PROVABLE_G) \
                            (MK_IMP (MK_IMP VAR_PROVABLE_G VAR_NOT_PROV) (MK_IMP VAR_GODEL_G VAR_NOT_PROV))

# Target Theorem: Gödel sentence implies unprovability (G -> ¬Provable(G))
THEOREM_GODEL_INCOMPLETE := MK_IMP VAR_GODEL_G VAR_NOT_PROV

GODEL_AXIOMS := cons AXIOM_GODEL_1 \
               (cons AXIOM_GODEL_2 \
               (cons AXIOM_GODEL_TRANS nil))

# Step 1: Cite Axiom 1
GODEL_STEP_1 := pair RULE_AXIOM (pair AXIOM_GODEL_1 nil)

# Step 2: Cite Axiom 2
GODEL_STEP_2 := pair RULE_AXIOM (pair AXIOM_GODEL_2 nil)

# Step 3: Cite Axiom 3 (Transitivity schema)
GODEL_STEP_3 := pair RULE_AXIOM (pair AXIOM_GODEL_TRANS nil)

# Step 4: Modus Ponens on Axiom 1 and Transitivity Schema
FORMULA_GODEL_INT := MK_IMP (MK_IMP VAR_PROVABLE_G VAR_NOT_PROV) THEOREM_GODEL_INCOMPLETE
GODEL_STEP_4 := pair RULE_MP (pair FORMULA_GODEL_INT (pair AXIOM_GODEL_1 AXIOM_GODEL_TRANS))

# Step 5: Modus Ponens on Axiom 2 and Intermediate Formula -> Target Theorem (G -> ¬Provable(G))
GODEL_STEP_5 := pair RULE_MP (pair THEOREM_GODEL_INCOMPLETE (pair AXIOM_GODEL_2 FORMULA_GODEL_INT))

PROOF_GODEL := cons GODEL_STEP_1 \
              (cons GODEL_STEP_2 \
              (cons GODEL_STEP_3 \
              (cons GODEL_STEP_4 \
              (cons GODEL_STEP_5 nil))))

ASSERT (VERIFY_PROOF GODEL_AXIOMS PROOF_GODEL)
ASSERT (IS_PROVABLE THEOREM_GODEL_INCOMPLETE GODEL_AXIOMS PROOF_GODEL)
