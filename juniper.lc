# FILE BEGIN juniper.lc -- DO NOT MODIFY

# --- Standard Terms ---
I,  IDENTITY := λx      .x
S            := λx y z  .x z (y z)
K            := λx y    .x
B            := λx y z  .x (y z)
C            := λx y z  .x z y
W            := λx y    .x y y
ω, Δ, U      := λx      .x x
Ω            := ω ω

Y            := λg      .(λx.g (x x)) (λx.g (x x))
Y2           := λ       .(λ .[1] ([0] [0])) (λ .[1] ([0] [0]))
#ASSERT_EQ Y, Y2 # RecursionError: maximum recursion depth exceeded
Z            := λg      .(λx.g (λv.x x v)) (λx.g (λv.x x v))

# --- Booleans ---
⊤,  TRUE     := K
⊥,  FALSE    := λx      .I
¬,  NOT      := λb      .b ⊥ ⊤
∧,  AND      := λp q    .p q ⊥
∨,  OR       := λp q    .p ⊤ q

# NOTE called IFTHENELSE elsewhere... maybe call it BRANCH ??? shorthand/arcane symbol would be great
IF           := λb t f  .b t f

ASSERT TRUE
ASSERT (NOT FALSE)
ASSERT AND TRUE TRUE
ASSERT NOT (AND TRUE FALSE)
ASSERT NOT (AND FALSE TRUE)
ASSERT NOT (AND FALSE FALSE)
ASSERT OR TRUE TRUE
ASSERT OR TRUE FALSE
ASSERT OR FALSE TRUE
ASSERT NOT (OR FALSE FALSE)

# TODO assert TRUE is not equal to FALSE
# TODO test IF

# --- Integers ---
0,  ZERO     := ⊥

SUCC         := λn f x  .f (n f x)
+,  PLUS     := λm n    .m SUCC n
#+            ≡ λm n f x.m f (n f x) # TODO assertions and proofs ?
*,  MULT     := λm n    .m (+ n) 0
#*,  MULT     ≡ λm n f  .m (n f) # TODO assertions and proofs ?
POW          := λb n    .n b
#POW′ := λb.λn.n (MULT b) 1 # TODO assertions and proofs ?
#POW′′ := λb.λn.λf.n b f # TODO assertions and proofs ?

#1,  ONE      := λf x.f x
#2,  TWO      := λf x.f (f x)
#3,  THREE    := λf x.f (f (f x))

1,  ONE      := SUCC 0
ASSERT_EQ 1, (λf x.f x)
2,  TWO      := SUCC 1
ASSERT_EQ 2, (λf x.f (f x))
3,  THREE    := SUCC 2
ASSERT_EQ 3, (λf x.f (f (f x)))

=0, IS_ZERO  := λn      .n (λx.⊥) ⊤
≤,  LEQ      := λm n    .=0 (- m n)

# --- Pairs (Duo) ---
PAIR         := λx y f  .f x y
1st, FIRST   := λp      .p ⊤
2nd, SECOND  := λp      .p ⊥
Φ            := λp      .PAIR (2nd p) (SUCC (2nd p))
Ψ            := λf p    .PAIR (2nd p) (f    (2nd p))

NIL          := ⊥
NULL         := λp      .p (λx y.⊥)


PRED         := λn      .1st (n (Ψ SUCC) (PAIR 0 0))
-,  SUB      := λm n    .n PRED m

CONS         := λh t c n.c h (t c n)
IS_NIL       := λl      .l (λh t.⊥) ⊤

# --- Structural Equality for Numbers/IDs ---
# Helper to compare Church numerals or tag identifiers
EQ_NUM       := λm n    .∧ (=0 (- m n)) (=0 (- n m))

# ⊻
