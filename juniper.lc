##
# pairs
##

PAIR         := λx y f  .f x y
1st, FIRST   := λp      .p ⊤
2nd, SECOND  := λp      .p ⊥
Φ            := λp      .PAIR (2nd p) (successor (2nd p))
Ψ            := λf p    .PAIR (2nd p) (f    (2nd p))

# TODO ∅
nil          := ⊥
NULL         := λp      .p (λx y.⊥)

CONS         := λh t c n.c h (t c n)
IS_NIL       := λl      .l (λh t.⊥) ⊤

