# --- AST Constructors ---
TAG_VAR := 0
# TODO should resugar to 1
TAG_IMP := SUCC 0
# TODO should resugar to 2
TAG_EQ  := SUCC (SUCC 0)

MK_VAR := \id.PAIR TAG_VAR id
MK_IMP := \a.\b.PAIR TAG_IMP (PAIR a b)
MK_EQ  := \a.\b.PAIR TAG_EQ (PAIR a b)

# --- AST Inspectors ---
GET_TAG := FIRST
GET_BODY := SECOND

IS_VAR := \e.EQ_NUM (GET_TAG e) TAG_VAR
IS_IMP := \e.EQ_NUM (GET_TAG e) TAG_IMP
IS_EQ  := \e.EQ_NUM (GET_TAG e) TAG_EQ

# --- Deep Formula Equality (IS_SAME_FORMULA) ---
# Recursively checks if two AST structures match exactly
#IS_SAME_FORMULA := \f1.\f2. \
#  IF (IS_VAR f1) \
#    (AND (IS_VAR f2) (EQ_NUM (GET_BODY f1) (GET_BODY f2))) \
#    (IF (IS_IMP f1) \
#      (AND (IS_IMP f2) \
#           (AND (IS_SAME_FORMULA (FIRST (GET_BODY f1)) (FIRST (GET_BODY f2))) \
#                (IS_SAME_FORMULA (SECOND (GET_BODY f1)) (SECOND (GET_BODY f2))))) \
#      (IF (IS_EQ f1) \
#        (AND (IS_EQ f2) \
#             (AND (IS_SAME_FORMULA (FIRST (GET_BODY f1)) (FIRST (GET_BODY f2))) \
#                  (IS_SAME_FORMULA (SECOND (GET_BODY f1)) (SECOND (GET_BODY f2))))) \
#        FALSE))

IS_SAME_FORMULA_REC := \self f1 f2. \
  IF (IS_VAR f1) \
    (AND (IS_VAR f2) (EQ_NUM (GET_BODY f1) (GET_BODY f2))) \
    (IF (IS_IMP f1) \
      (AND (IS_IMP f2) \
           (AND (self (FIRST (GET_BODY f1)) (FIRST (GET_BODY f2))) \
                (self (SECOND (GET_BODY f1)) (SECOND (GET_BODY f2))))) \
      (IF (IS_EQ f1) \
        (AND (IS_EQ f2) \
             (AND (self (FIRST (GET_BODY f1)) (FIRST (GET_BODY f2))) \
                  (self (SECOND (GET_BODY f1)) (SECOND (GET_BODY f2))))) \
        FALSE))

IS_SAME_FORMULA := Y IS_SAME_FORMULA_REC



# --- Terms ---
VAR_X := MK_VAR (SUCC ZERO)
VAR_Y := MK_VAR (SUCC (SUCC ZERO))

# --- Axiom 1: Reflexivity of Equality (x = x) ---
AXIOM_REFLEXIVE := MK_EQ VAR_X VAR_X

# --- Axiom 2: Zero is not the Successor of any number (S(x) = 0 -> FALSE) ---
# Represented structurally as Implication: S(x) = 0 -> x != x
S_X := MK_VAR (SUCC (SUCC (SUCC ZERO))) # S(x) term
AXIOM_ZERO_SUCC := MK_IMP (MK_EQ S_X (MK_VAR ZERO)) (MK_EQ VAR_X VAR_Y)

# --- Full Axiom List ---
AXIOM_SET := CONS AXIOM_REFLEXIVE (CONS AXIOM_ZERO_SUCC NIL)



# --- Check if Formula is in Axiom Set ---
IS_AXIOM := \formula.\axioms. \
  axioms (\h.\acc.OR (IS_SAME_FORMULA formula h) acc) FALSE

# --- Modus Ponens Verifier ---
# Given Premise 1 (A), Premise 2 (A -> B), and Target (B):
# Validates that Premise 2 is an Implication, its antecedent matches A, and consequence matches B.
VERIFY_MP := \p1.\p2.\target. \
  IF (IS_IMP p2) \
    (AND (IS_SAME_FORMULA p1 (FIRST (GET_BODY p2))) \
         (IS_SAME_FORMULA target (SECOND (GET_BODY p2)))) \
    FALSE

# --- Single Step Checker ---
# A step is a tuple: PAIR Rule_Type (PAIR Target_Formula Parameters)
# Rule 0: Axiom Assertion (Parameters = Ignored)
# Rule 1: Modus Ponens (Parameters = PAIR Premise1 Premise2)
RULE_AXIOM := ZERO
RULE_MP    := SUCC ZERO

###CHECK_STEP := \step.\axioms.\history. \
###  \rule. \payload. \target. \params. \
###  (rule = RULE_AXIOM) \
###    (IS_AXIOM target axioms) \
###    ((rule = RULE_MP) \
###      (VERIFY_MP (FIRST params) (SECOND params) target) \
###      FALSE)
### Corrected Single Step Checker
##CHECK_STEP := \step.\axioms.\history. \
##  \rule.\payload. \
##  IF (EQ_NUM rule RULE_AXIOM) \
##    (IS_AXIOM (FIRST payload) axioms) \
##    (IF (EQ_NUM rule RULE_MP) \
##      (VERIFY_MP (FIRST (SECOND payload)) (SECOND (SECOND payload)) (FIRST payload)) \
##      FALSE)
#CHECK_STEP := \step.\axioms.\history. \
#  \rule.\payload. \
#  IF (EQ_NUM rule RULE_AXIOM) \
#    (IS_AXIOM (FIRST payload) axioms) \
#    (IF (EQ_NUM rule RULE_MP) \
#      (VERIFY_MP (FIRST (SECOND payload)) (SECOND (SECOND payload)) (FIRST payload)) \
#      FALSE)
CHECK_STEP := \step.\axioms.\history. \
  step (\rule.\payload. \
    IF (EQ_NUM rule RULE_AXIOM) \
      (IS_AXIOM (FIRST payload) axioms) \
      (IF (EQ_NUM rule RULE_MP) \
        (VERIFY_MP (FIRST (SECOND payload)) (SECOND (SECOND payload)) (FIRST payload)) \
        FALSE))

# --- Proof List Verifier ---
# Iterates through a list of steps, verifying each against axioms and prior history
VERIFY_PROOF := \axioms.\proof. \
  proof (\step.\acc_result. \
    AND acc_result (CHECK_STEP step axioms NIL) \
  ) TRUE





# --- Target Theorem: x = x ---
THEOREM_REFLEXIVE := MK_EQ VAR_X VAR_X

# --- Step 1: Assert AXIOM_REFLEXIVE ---
STEP_1 := PAIR RULE_AXIOM (PAIR THEOREM_REFLEXIVE NIL)

# --- Proof Sequence ---
PROOF_1 := CONS STEP_1 NIL

# --- FINAL EVALUATION ---
# Running this term reduces down purely to TRUE (\x.\y.x)
MAIN := VERIFY_PROOF AXIOM_SET PROOF_1

MAIN
ASSERT MAIN











# --- AST Substitution Mechanism ---
# Replaces occurrences of a specific variable ID with a given term within an AST formula.
SUBST_REC := \self. \target_id. \subst_term. \expr. \
  IF (IS_VAR expr) \
    (IF (EQ_NUM (GET_BODY expr) target_id) subst_term expr) \
    (IF (IS_IMP expr) \
      (MK_IMP (self target_id subst_term (FIRST (GET_BODY expr))) \
              (self target_id subst_term (SECOND (GET_BODY expr)))) \
      (IF (IS_EQ expr) \
        (MK_EQ (self target_id subst_term (FIRST (GET_BODY expr))) \
               (self target_id subst_term (SECOND (GET_BODY expr)))) \
        expr))

SUBST := Y SUBST_REC

# --- Substitution Assertions & Tests ---
TEST_VAR_ID     := SUCC ZERO
TEST_TARGET_VAL := MK_VAR (SUCC (SUCC ZERO))
TEST_FORMULA    := MK_EQ (MK_VAR TEST_VAR_ID) (MK_VAR TEST_VAR_ID)

# Perform substitution: replace variable 1 with VAR_Y in (var 1 = var 1)
TEST_SUBST_RES  := SUBST TEST_VAR_ID TEST_TARGET_VAL TEST_FORMULA
EXPECTED_RES    := MK_EQ TEST_TARGET_VAL TEST_TARGET_VAL

# Verify structural match of the substitution result
ASSERT (IS_SAME_FORMULA TEST_SUBST_RES EXPECTED_RES)

