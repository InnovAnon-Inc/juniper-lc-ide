# --- Meta-Circular Compiler: AST for De Bruijn Terms ---
TAG_DB_VAR := 0
TAG_DB_ABS := 1
TAG_DB_APP := 2

MK_DB_VAR := \idx. pair TAG_DB_VAR idx
MK_DB_ABS := \body. pair TAG_DB_ABS body
MK_DB_APP := \fun. \arg. pair TAG_DB_APP (pair fun arg)

IS_DB_VAR := \t. EQ_NUM (first t) TAG_DB_VAR
#IS_DB_ABS := \t. EQ_NUM (first t) TAG_DB_ABS
#IS_DB_APP := \t. EQ_NUM (first t) TAG_DB_APP
IS_DB_ABS := \t. EQ_NUM (first t) TAG_DB_ABS
IS_DB_APP := \t. EQ_NUM (first t) TAG_DB_APP

DB_VAR_INDEX := second
DB_ABS_BODY  := second
DB_APP_FUN   := \t. first (second t)
DB_APP_ARG   := \t. second (second t)

# --- Meta-Circular Compiler: Structural Equality ---
DB_EQUAL_REC := \self. \t1. \t2. \
  if (IS_DB_VAR t1) \
    (and (IS_DB_VAR t2) (EQ_NUM (second t1) (second t2))) \
    (if (IS_DB_ABS t1) \
      (and (IS_DB_ABS t2) (self (second t1) (second t2))) \
      (if (IS_DB_APP t1) \
        (and (IS_DB_APP t2) \
             (and (self (first (second t1)) (first (second t2))) \
                  (self (second (second t1)) (second (second t2))))) \
        false))

DB_EQUAL := Y DB_EQUAL_REC

# --- Utility: Math Comparisons ---

# --- Meta-Circular Compiler: De Bruijn Shifting ---
SHIFT_REC := \self. \t. \d. \c. \
  if (IS_DB_VAR t) \
    (( \idx. if (geq idx c) (MK_DB_VAR (+ idx d)) t ) (second t)) \
    (if (IS_DB_ABS t) \
      (MK_DB_ABS (self (second t) d (successor c))) \
      (if (IS_DB_APP t) \
        (MK_DB_APP (self (first (second t)) d c) (self (second (second t)) d c)) \
        t))

SHIFT := Y SHIFT_REC

# --- Meta-Circular Compiler: Substitution ---
DB_SUBSTITUTE_REC := \self. \t. \v. \i. \
  if (IS_DB_VAR t) \
    (( \idx. \
         if (EQ_NUM idx i) \
           (SHIFT v i 0) \
           (if (gt idx i) (MK_DB_VAR (predecessor idx)) t) \
     ) (second t)) \
    (if (IS_DB_ABS t) \
      (MK_DB_ABS (self (second t) v (successor i))) \
      (if (IS_DB_APP t) \
        (MK_DB_APP (self (first (second t)) v i) (self (second (second t)) v i)) \
        t))

DB_SUBSTITUTE := Y DB_SUBSTITUTE_REC

# --- Meta-Circular Compiler: Beta Reduction Step ---
BETA_REDUCE_STEP_REC := \self. \t. \
  if (IS_DB_APP t) \
    (( \fun. \arg. \
         if (IS_DB_ABS fun) \
           (pair (DB_SUBSTITUTE (second fun) arg 0) true) \
           (( \res. \
                if (second res) \
                  (pair (MK_DB_APP (first res) arg) true) \
                  (pair t false) \
            ) (self fun)) \
     ) (first (second t)) (second (second t))) \
    (pair t false)

BETA_REDUCE_STEP := Y BETA_REDUCE_STEP_REC

# --- Meta-Circular Compiler: Full Normalization ---
NORMALIZE_REC := \self. \t. \
  (( \res. \
       if (second res) \
         (self (first res)) \
         (if (IS_DB_ABS t) \
           (MK_DB_ABS (self (second t))) \
           (if (IS_DB_APP t) \
             (MK_DB_APP (self (first (second t))) (self (second (second t)))) \
             t)) \
   ) (BETA_REDUCE_STEP t))

NORMALIZE := Y NORMALIZE_REC

# --- Meta-Circular Compiler: Church Numeral Decoder ---
CHECK_CHURCH_BODY_REC := \self. \curr. \count. \
  if (IS_DB_APP curr) \
    (( \fun. \arg. \
         if (and (IS_DB_VAR fun) (EQ_NUM (second fun) 1)) \
           (self arg (successor count)) \
           (pair false 0) \
     ) (first (second curr)) (second (second curr))) \
    (if (and (IS_DB_VAR curr) (EQ_NUM (second curr) 0)) \
      (pair true count) \
      (pair false 0))

CHECK_CHURCH_BODY := Y CHECK_CHURCH_BODY_REC

TRY_DECODE_CHURCH := \t. \
  if (IS_DB_ABS t) \
    (if (IS_DB_ABS (second t)) \
      (CHECK_CHURCH_BODY (second (second t)) 0) \
      (pair false 0)) \
    (pair false 0)

# --- Utility: Maximum ---
MAX := \m. \n. if (geq m n) m n

# --- Meta-Circular Compiler: Structural Complexity ---
DB_NODE_COUNT_REC := \self. \t. \
  if (IS_DB_VAR t) 1 \
    (if (IS_DB_ABS t) (successor (self (second t))) \
      (if (IS_DB_APP t) \
        (successor (+ (self (first (second t))) (self (second (second t))))) \
        1))

DB_NODE_COUNT := Y DB_NODE_COUNT_REC

DB_DEPTH_REC := \self. \t. \
  if (IS_DB_VAR t) 1 \
    (if (IS_DB_ABS t) (successor (self (second t))) \
      (if (IS_DB_APP t) \
        (successor (MAX (self (first (second t))) (self (second (second t))))) \
        1))

DB_DEPTH := Y DB_DEPTH_REC

# --- Meta-Circular Compiler: Environment Management ---
ENV_LOOKUP_REC := \self. \env. \key. \
  if (=nil env) \
    nil \
    (( \head. \
         if (EQ_NUM (first head) key) \
           (pair true (second head)) \
           (self (second env) key) \
     ) (first env))

ENV_LOOKUP := Y ENV_LOOKUP_REC

EXTEND_ENV := \env. \key. \val. cons (pair key val) env

# --- Meta-Circular Compiler: Statement Evaluator ---
TAG_STMT_ASSIGN    := 0
TAG_STMT_ASSERT    := 1
TAG_STMT_ASSERT_EQ := 2
TAG_STMT_EVAL      := 3

MK_STMT_ASSIGN    := \id. \expr. pair TAG_STMT_ASSIGN (pair id expr)
MK_STMT_ASSERT    := \expr. pair TAG_STMT_ASSERT expr
MK_STMT_ASSERT_EQ := \left. \right. pair TAG_STMT_ASSERT_EQ (pair left right)
MK_STMT_EVAL      := \expr. pair TAG_STMT_EVAL expr

EVAL_STATEMENT := \env. \stmt. \
  (( \tag. \payload. \
       if (EQ_NUM tag TAG_STMT_ASSIGN) \
         (( \key. \expr. \
              (pair (EXTEND_ENV env key (NORMALIZE expr)) true) \
          ) (first payload) (second payload)) \
         (if (EQ_NUM tag TAG_STMT_ASSERT) \
           (pair env (DB_EQUAL (NORMALIZE payload) ⊤)) \
           (if (EQ_NUM tag TAG_STMT_ASSERT_EQ) \
             (pair env (DB_EQUAL (NORMALIZE (first payload)) (NORMALIZE (second payload)))) \
             (if (EQ_NUM tag TAG_STMT_EVAL) \
               (pair env true) \
               (pair env false)))) \
   ) (first stmt) (second stmt))

# --- Meta-Circular Self-Verification ---

# Test Terms
TEST_IDENTITY := MK_DB_ABS (MK_DB_VAR 0)
TEST_APP_ID   := MK_DB_APP TEST_IDENTITY (MK_DB_VAR 5)

# Verify Normalization: ((λ.[0]) [5]) -> [5]
#ASSERT (DB_EQUAL (NORMALIZE TEST_APP_ID) (MK_DB_VAR 5)) # FIXME

# Verify Structural Metrics: (λ.[0]) has 2 nodes and depth 2
ASSERT (EQ_NUM (DB_NODE_COUNT TEST_IDENTITY) 2)
ASSERT (EQ_NUM (DB_DEPTH TEST_IDENTITY) 2)

# Verify Church Numeral Decoding for Church 2: λf.λx. f (f x)
TEST_CHURCH_2 := MK_DB_ABS (MK_DB_ABS (MK_DB_APP (MK_DB_VAR 1) (MK_DB_APP (MK_DB_VAR 1) (MK_DB_VAR 0))))
TEST_DECODE   := TRY_DECODE_CHURCH TEST_CHURCH_2
ASSERT (first TEST_DECODE)
ASSERT (EQ_NUM (second TEST_DECODE) 2)

# Verify Environment Lookup and Statement Execution
EMPTY_ENV  := nil
STMT_1     := MK_STMT_ASSIGN 10 TEST_IDENTITY
EXEC_RES_1 := EVAL_STATEMENT EMPTY_ENV STMT_1
NEW_ENV_1  := first EXEC_RES_1

LOOKUP_RES := ENV_LOOKUP NEW_ENV_1 10
ASSERT (first LOOKUP_RES)
#ASSERT (DB_EQUAL (second LOOKUP_RES) TEST_IDENTITY) # FIXME

# Verify Meta-Assertion Statement: ASSERT_EQ ((λ.[0]) [5]) [5]
STMT_2     := MK_STMT_ASSERT_EQ TEST_APP_ID (MK_DB_VAR 5)
EXEC_RES_2 := EVAL_STATEMENT NEW_ENV_1 STMT_2
#ASSERT (second EXEC_RES_2) # FIXME












##
# Formal Proof Suite (Executed by Meta-Circular Proof Verifier)
##

# --- Axiom Definitions ---
THEOREM_IMP_REFLEX := MK_IMP AXIOM_REFLEXIVE AXIOM_REFLEXIVE
PROOF_AXIOMS       := CONS THEOREM_IMP_REFLEX (CONS AXIOM_REFLEXIVE nil)

# --- Formal Proof Steps ---
# Step 1: Cite Reflexivity Axiom (x = x)
PROOF_STEP_1 := PAIR RULE_AXIOM (PAIR AXIOM_REFLEXIVE nil)

# Step 2: Cite Implication Axiom (x = x -> x = x)
PROOF_STEP_2 := PAIR RULE_AXIOM (PAIR THEOREM_IMP_REFLEX nil)

# Step 3: Apply Modus Ponens (P1: x=x, P2: x=x -> x=x, Target: x=x)
PROOF_STEP_3 := PAIR RULE_MP (PAIR AXIOM_REFLEXIVE (PAIR AXIOM_REFLEXIVE THEOREM_IMP_REFLEX))

# --- Complete Proof Sequence ---
FORMAL_PROOF_CHAIN := CONS PROOF_STEP_1 (CONS PROOF_STEP_2 (CONS PROOF_STEP_3 nil))

# --- Execute Proof Verifier ---
PROOF_VERIFICATION_RESULT := VERIFY_PROOF PROOF_AXIOMS FORMAL_PROOF_CHAIN
#ASSERT PROOF_VERIFICATION_RESULT # FIXME hangs

# Verify target theorem matching
#ASSERT (IS_PROVABLE AXIOM_REFLEXIVE PROOF_AXIOMS FORMAL_PROOF_CHAIN) # FIXME hangs






# Scott-encoded constructors for De Bruijn terms
VAR := λi.   λv a p. v i
ABS := λb.   λv a p. a b
APP := λf a. λv a p. p f a

# Recursive AST node-count metric function in LC:
# SIZE(Var i)   = 1
# SIZE(Abs b)   = 1 + SIZE(b)
# SIZE(App f a) = 1 + SIZE(f) + SIZE(a)
#SIZE := Y (λself term. \
#  term \
#    (λi. 1) \
#    (λb. ADD 1 (self b)) \
#    (λf a. ADD 1 (ADD (self f) (self a))) \
#)
SIZE := Y (λself term. \
  term \
    (λi. 1) \
    (λb. + 1 (self b)) \
    (λf a. + 1 (+ (self f) (self a))) \
)





























# AST Node Count Metric
DB_SIZE_REC := \self t. \
  if (IS_DB_VAR t) 1 \
    (if (IS_DB_ABS t) (successor (self (second t))) \
      (if (IS_DB_APP t) \
        (successor (+ (self (first (second t))) (self (second (second t))))) \
        1))
DB_SIZE := Y DB_SIZE_REC

# AST Depth Metric
DB_DEPTH_REC := \self t. \
  if (IS_DB_VAR t) 1 \
    (if (IS_DB_ABS t) (successor (self (second t))) \
      (if (IS_DB_APP t) \
        (successor (MAX (self (first (second t))) (self (second (second t))))) \
        1))
DB_DEPTH := Y DB_DEPTH_REC



# Single Beta-Reduction Step with Step Counter
STEP_COUNT_REDUCE_REC := \self t steps. \
  if (IS_DB_APP t) \
    (( \fun arg. \
         if (IS_DB_ABS fun) \
           (pair (DB_SUBSTITUTE (second fun) arg 0) (successor steps)) \
           (( \res. \
                if (second res) \
                  (pair (MK_DB_APP (first res) arg) (second res)) \
                  (pair t steps) \
            ) (self fun steps)) \
     ) (first (second t)) (second (second t))) \
    (pair t steps)

STEP_COUNT_REDUCE := Y STEP_COUNT_REDUCE_REC

# Compute Normal Form and Total Beta-Step Count
EVAL_TIME_REC := \self t steps. \
  (( \res. \
       if (> (second res) steps) \
         (self (first res) (second res)) \
         (pair t steps) \
   ) (STEP_COUNT_REDUCE t steps))

EVAL_TIME := \t. EVAL_TIME_REC t 0


