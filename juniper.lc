## --- Proof List Verifier ---
## Iterates through a list of steps, verifying each against axioms and prior history
#VERIFY_PROOF := \axioms.\proof. \
#  proof (\step.\acc_result. \
#    and acc_result (CHECK_STEP step axioms nil) \
#  ) true
# --- 1. List Operations ---
# Checks if a formula exists in a list (replacing IS_AXIOM)
IN_LIST := \formula. \lst. \
  lst (\h. \acc. or (IS_SAME_FORMULA formula h) acc) false

# Left fold for Church lists: FOLDL f init [a, b, c] -> f (f (f init a) b) c
FOLDL := \f. \init. \lst. \
  lst (\elem. \acc_func. \curr_acc. \
    acc_func (f curr_acc elem) \
  ) identity init

# --- 2. Step Validator ---
# Now requires 'history' to prove premises exist before applying them.
CHECK_STEP := \step. \history. \
  step (\rule. \payload. \
    payload (\target. \params. \
      IF (EQ_NUM rule RULE_AXIOM) \
        (IN_LIST target history) \
        (IF (EQ_NUM rule RULE_MP) \
          (and (IN_LIST (FIRST params) history) \
               (and (IN_LIST (SECOND params) history) \
                    (VERIFY_MP (FIRST params) (SECOND params) target))) \
          false)))

GET_STEP_FORMULA := \step. FIRST (SECOND step)

# --- 3. Stateful Step Processor ---
# Takes the threaded state (PAIR is_valid history) and the current step.
# If valid, it adds the step's conclusion to the history. If invalid, it short-circuits.
PROCESS_STEP := \state. \step. \
  state (\is_valid. \history. \
    IF is_valid \
      (IF (CHECK_STEP step history) \
        (PAIR true (CONS (GET_STEP_FORMULA step) history)) \
        (PAIR false history)) \
      (PAIR false history))

# --- 4. The Multi-Step Proof Verifier ---
# Initializes state with (true, axioms) and extracts the final boolean flag.
VERIFY_PROOF := \axioms. \proof. \
  FIRST (FOLDL PROCESS_STEP (PAIR true axioms) proof)





# --- Target Theorem: x = x ---
THEOREM_REFLEXIVE := MK_EQ VAR_X VAR_X

# --- Step 1: Assert AXIOM_REFLEXIVE ---
STEP_1 := PAIR RULE_AXIOM (PAIR THEOREM_REFLEXIVE nil)

# --- Proof Sequence ---
PROOF_1 := CONS STEP_1 nil

# --- FINAL EVALUATION ---
# Running this term reduces down purely to true (\x.\y.x)
MAIN := VERIFY_PROOF AXIOM_SET PROOF_1

MAIN
ASSERT MAIN











# --- AST Substitution Mechanism ---
# Replaces occurrences of a specific variable ID with a given term within an AST formula.
SUBST_REC := \self. \target_id. \subst_term. \expr. \
  IF (IS_VAR expr) \
    (IF (EQ_NUM (GET_BODY expr) target_id) subst_term expr) \
    (IF (IS_IMP expr) \
      (MK_IMP (self target_id subst_term (FIRST (GET_BODY expr))) \
              (self target_id subst_term (SECOND (GET_BODY expr)))) \
      (IF (IS_EQ expr) \
        (MK_EQ (self target_id subst_term (FIRST (GET_BODY expr))) \
               (self target_id subst_term (SECOND (GET_BODY expr)))) \
        expr))

SUBST := Y SUBST_REC

# --- Substitution Assertions & Tests ---
TEST_VAR_ID     := successor 0
TEST_TARGET_VAL := MK_VAR (successor (successor 0))
TEST_FORMULA    := MK_EQ (MK_VAR TEST_VAR_ID) (MK_VAR TEST_VAR_ID)

# Perform substitution: replace variable 1 with VAR_Y in (var 1 = var 1)
TEST_SUBST_RES  := SUBST TEST_VAR_ID TEST_TARGET_VAL TEST_FORMULA
EXPECTED_RES    := MK_EQ TEST_TARGET_VAL TEST_TARGET_VAL

# Verify structural match of the substitution result
ASSERT (IS_SAME_FORMULA TEST_SUBST_RES EXPECTED_RES)

