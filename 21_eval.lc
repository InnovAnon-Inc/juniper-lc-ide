# --- Meta-Circular Compiler: Reduction & Evaluation ---
# Evaluates De Bruijn terms using capture-avoiding substitution under normal order.
DB_EVAL_REC := \self. \t. \
  if (IS_DB_APP t) \
    (( \fun. \arg. \
         if (IS_DB_ABS fun) \
           (self (DB_SUBSTITUTE (second fun) arg 0)) \
           (MK_DB_APP (self fun) (self arg)) \
     ) (first (second t)) (second (second t))) \
    (if (IS_DB_ABS t) \
      (MK_DB_ABS (self (second t))) \
      t)

DB_EVAL := Y DB_EVAL_REC

# --- Meta-Circular Compiler: Idempotency & Beta-Equivalence Verification ---
# Verifies that evaluating a term twice or resugaring and parsing is invariant.
DB_EQUIV := \t1. \t2. DB_EQUAL (DB_EVAL t1) (DB_EVAL t2)

