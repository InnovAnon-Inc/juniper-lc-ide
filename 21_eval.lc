# --- Meta-Circular Self-Verification of Metrics ---

TEST_TERM := MK_DB_ABS (MK_DB_VAR 0)

# Verify AST Size Metric
ASSERT_EQ (DB_SIZE TEST_TERM), 2

# Verify Static Complexity Evaluation Output
COMPLEXITY_RES := ANALYZE_STATIC_COMPLEXITY TEST_TERM
