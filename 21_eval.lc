# --- Meta-Circular Compiler: AST for De Bruijn Terms ---
TAG_DB_VAR := 0
TAG_DB_ABS := 1
TAG_DB_APP := 2

MK_DB_VAR := \idx. pair TAG_DB_VAR idx
MK_DB_ABS := \body. pair TAG_DB_ABS body
MK_DB_APP := \fun. \arg. pair TAG_DB_APP (pair fun arg)

IS_DB_VAR := \t. EQ_NUM (first t) TAG_DB_VAR
#IS_DB_ABS := \t. EQ_NUM (first t) TAG_DB_ABS
#IS_DB_APP := \t. EQ_NUM (first t) TAG_DB_APP
IS_DB_ABS := \t. EQ_NUM (first t) TAG_DB_ABS
IS_DB_APP := \t. EQ_NUM (first t) TAG_DB_APP

DB_VAR_INDEX := second
DB_ABS_BODY  := second
DB_APP_FUN   := \t. first (second t)
DB_APP_ARG   := \t. second (second t)

# --- Meta-Circular Compiler: Structural Equality ---
DB_EQUAL_REC := \self. \t1. \t2. \
  if (IS_DB_VAR t1) \
    (and (IS_DB_VAR t2) (EQ_NUM (second t1) (second t2))) \
    (if (IS_DB_ABS t1) \
      (and (IS_DB_ABS t2) (self (second t1) (second t2))) \
      (if (IS_DB_APP t1) \
        (and (IS_DB_APP t2) \
             (and (self (first (second t1)) (first (second t2))) \
                  (self (second (second t1)) (second (second t2))))) \
        false))

DB_EQUAL := Y DB_EQUAL_REC

# --- Utility: Math Comparisons ---

# --- Meta-Circular Compiler: De Bruijn Shifting ---
SHIFT_REC := \self. \t. \d. \c. \
  if (IS_DB_VAR t) \
    (( \idx. if (geq idx c) (MK_DB_VAR (+ idx d)) t ) (second t)) \
    (if (IS_DB_ABS t) \
      (MK_DB_ABS (self (second t) d (successor c))) \
      (if (IS_DB_APP t) \
        (MK_DB_APP (self (first (second t)) d c) (self (second (second t)) d c)) \
        t))

SHIFT := Y SHIFT_REC

## --- Meta-Circular Compiler: Substitution ---
#DB_SUBSTITUTE_REC := \self. \t. \v. \i. \
#  if (IS_DB_VAR t) \
#    (( \idx. \
#         if (EQ_NUM idx i) \
#           (SHIFT v i 0) \
#           (if (gt idx i) (MK_DB_VAR (predecessor idx)) t) \
#     ) (second t)) \
#    (if (IS_DB_ABS t) \
#      (MK_DB_ABS (self (second t) v (successor i))) \
#      (if (IS_DB_APP t) \
#        (MK_DB_APP (self (first (second t)) v i) (self (second (second t)) v i)) \
#        t))
#
#DB_SUBSTITUTE := Y DB_SUBSTITUTE_REC

# --- Meta-Circular Compiler: Substitution (Completed) ---
DB_SUBSTITUTE_REC := \self. \t. \v. \i. \
  if (IS_DB_VAR t) \
    (( \idx. \
         if (EQ_NUM idx i) \
           (SHIFT v i 0) \
           (if (gt idx i) (MK_DB_VAR (predecessor idx)) t) \
    ) (second t)) \
    (if (IS_DB_ABS t) \
      (MK_DB_ABS (self (second t) v (successor i))) \
      (if (IS_DB_APP t) \
        (MK_DB_APP (self (first (second t)) v i) (self (second (second t)) v i)) \
        t))

DB_SUBSTITUTE := Y DB_SUBSTITUTE_REC

# --- Meta-Circular Compiler: Beta Reduction (Single Step) ---
# When evaluating an application (λ body) arg:
# 1. Substitute arg into body (with index 0)
# 2. Shift free variables appropriately (-1 after reduction)
UNSHIFT_REC := \self. \t. \d. \c. \
  if (IS_DB_VAR t) \
    (( \idx. if (geq idx c) (MK_DB_VAR (- idx d)) t ) (second t)) \
    (if (IS_DB_ABS t) \
      (MK_DB_ABS (self (second t) d (successor c))) \
      (if (IS_DB_APP t) \
        (MK_DB_APP (self (first (second t)) d c) (self (second (second t)) d c)) \
        t))

UNSHIFT := Y UNSHIFT_REC














# Beta reduction of an application term: [arg / 0]body, then unshift
β-reduce, beta-reduce := \t. \
  if (IS_DB_APP t) \
    (( \fun. \arg. \
         if (IS_DB_ABS fun) \
           (UNSHIFT (DB_SUBSTITUTE (second fun) (SHIFT arg 1 0) 0) 1 0) \
           t \
    ) (first (second t)) (second (second t))) \
    t

# --- Meta-Circular Compiler: Evaluator (Normal Order / Head Reduction) ---
#EVAL_REC := \self. \t. \
#  if (IS_DB_VAR t) \
#    t \
#    (if (IS_DB_ABS t) \
#      (MK_DB_ABS (self (second t))) \
#      (if (IS_DB_APP t) \
#        (( \reduced. \
#             if (DB_EQUAL reduced t) \
#               (( \fun. \arg. MK_DB_APP (self fun) (self arg) ) (first (second t)) (second (second t))) \
#               (self reduced) \
#        ) (β-reduce t)) \
#        t))
#
#EVAL := Y EVAL_REC

# --- Meta-Circular Evaluator: Evaluation Function ---
# Evaluates De Bruijn terms using full beta-reduction (normal order)
EVAL_REC := \self. \t. \
  if (IS_DB_VAR t) \
    t \
    (if (IS_DB_ABS t) \
      (MK_DB_ABS (self (DB_ABS_BODY t))) \
      (if (IS_DB_APP t) \
        (( \fun. \arg. \
           if (IS_DB_ABS fun) \
             (self (DB_SUBSTITUTE (DB_ABS_BODY fun) arg 0)) \
             (MK_DB_APP (self fun) (self arg)) \
         ) (self (DB_APP_FUN t)) (self (DB_APP_ARG t))) \
        t))

eval := Y EVAL_REC

# --- Meta-Circular Evaluator: Assertions ---
# Helper assertion primitive: verifies that two De Bruijn terms are structurally equal
ASSERT_DB_EQ := \msg. \t1. \t2. \
  if (DB_EQUAL t1 t2) \
    true \
    (error msg)

# Test 1: Structural Equality Reflexivity
ASSERT_DB_EQ "Test 1 Failed: Reflexivity of DB_EQUAL" \
  (MK_DB_ABS (MK_DB_VAR 0)) \
  (MK_DB_ABS (MK_DB_VAR 0))

# Test 2: Shifting preserves variable indices below cutoff and shifts above
# Shift index 0 by +1 at cutoff 0 -> should become index 1
ASSERT_DB_EQ "Test 2 Failed: SHIFT operation" \
  (MK_DB_VAR 1) \
  (SHIFT (MK_DB_VAR 0) 1 0)

# Test 3: Beta-reduction of Identity applied to Variable
# (\x. x) y  ==>  y
# De Bruijn representation: APP (ABS (VAR 0)) (VAR 1) [assuming y is free index 1]
TERM_ID_APP := MK_DB_APP (MK_DB_ABS (MK_DB_VAR 0)) (MK_DB_VAR 1)
ASSERT_DB_EQ "Test 3 Failed: Meta-circular evaluation of (\x. x) y" \
  (MK_DB_VAR 1) \
  (eval TERM_ID_APP)

