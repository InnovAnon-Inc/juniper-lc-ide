#! /usr/bin/env lc

##
# standard terms
##

I, identity := λx    .x
S           := λx y z.x z (y z)
K           := λx y  .x
B           := λx y z.x (y z)
C           := λx y z.x z y
W           := λx y  .x y y
ω,Δ, U      := λx    .x x
Ω           := ω ω

Y           := λg    . \
  (λx.g (x x))         \
  (λx.g (x x))
Z           := λg    . \
  (λx.g (λv.x x v))    \
  (λx.g (λv.x x v))

