#! /usr/bin/env lc

##
# pair
##

INCLUDE "01_standard_terms.lc"
INCLUDE "02_fol.lc"

pair         := λx y f  .f x y
1st, first   := λp      .p ⊤
2nd, second  := λp      .p ⊥
head, car    := λl      .l K ⊥
cdr    := λl      .l nil ⊥
tail         := λl      .    \
   1st                       \
   (l                        \
      (λh acc.               \
         pair                \
         (2nd acc)           \
         (cons h (2nd acc))) \
      (pair nil nil))
Φ            := λp      .pair (2nd p) (successor (2nd p))
Ψ            := λf p    .pair (2nd p) (f         (2nd p))

∅, nil       := ⊥
null         := λp      .p (λx y.⊥)

cons         := λh t c n.c h (t c n)
=∅, =nil     := λl      .l (λh t.⊥) ⊤

