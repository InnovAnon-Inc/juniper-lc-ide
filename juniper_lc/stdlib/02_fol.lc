#! /usr/bin/env lc

##
# F.O.L.
##

INCLUDE "01_standard_terms.lc"

⊤,  true   := K
⊥,  false  := λ     .I
¬,  not    := λb    .b ⊥ ⊤
∧,  and    := λp q  .p q ⊥
∨,  or     := λp q  .p ⊤ q

⊻, xor     := λp q  . \
  ∧                   \
  (∨ p q)             \
  (∨ (¬ p) (¬ q))
⇒, implies := λp q  .∨ (¬ p) q
⇔, iff     := λp q  .∧ (⇒ p q) (⇒ q p)

if         := λb t f.b t f

