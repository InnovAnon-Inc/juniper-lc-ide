#! /usr/local/bin/lc.py

INCLUDE "01_standard_terms.lc"

a-test := \x. x
ASSERT_EQ I, a-test
b-test := \x. \
    x
ASSERT_EQ I, b-test
# FIXME parse failure:
c-test := \x.
    x
ASSERT_EQ I, c-test
# FIXME parse failure:
d-test := \x. # comment
    x
ASSERT_EQ I, d-test
# FIXME parse failure:
e-test := \x. \ # comment
    x
ASSERT_EQ I, e-test

β-reduce := \t. \
  if (IS_DB_APP t) \
    (let ((fun (DB_APP_FUN t)) (arg (DB_APP_ARG t))) \
      (if (IS_DB_ABS fun) \
        (let ((subbed (DB_SUBSTITUTE (DB_ABS_BODY fun) arg 0))) \
          (if (IS_DB_VAR subbed) \
            subbed \
            (if (IS_DB_APP subbed) \
              (β-reduce subbed) \
              subbed))))) \
    t

# Test case
TEST := MK_DB_APP (MK_DB_ABS (MK_DB_VAR 0)) (MK_DB_VAR 42)
RESULT := β-reduce TEST

# Verify the result
ASSERT (DB_EQUAL RESULT (MK_DB_VAR 42))
